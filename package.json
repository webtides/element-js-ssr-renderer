{
  "name": "@webtides/element-js-ssr-renderer",
  "version": "0.4.1",
  "description": "Server-side rendering for @webtides/element-js custom elements. Recursively pre-renders custom elements in an HTML string — emitting Declarative Shadow DOM for shadow components — so they hydrate in the browser instead of rendering from scratch.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/webtides/element-js-ssr-renderer",
  "engines": {
    "node": ">=20.19"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./autoloader": {
      "types": "./types/autoloader.d.ts",
      "default": "./src/autoloader.js"
    },
    "./dom-shim": {
      "types": "./types/dom-shim.d.ts",
      "default": "./src/dom-shim.js"
    },
    "./astro": {
      "types": "./types/adapters/astro.d.ts",
      "default": "./src/adapters/astro.js"
    },
    "./eleventy": {
      "types": "./types/adapters/eleventy.d.ts",
      "default": "./src/adapters/eleventy.js"
    },
    "./node": {
      "types": "./types/adapters/node.d.ts",
      "default": "./src/adapters/node.js"
    },
    "./nuxt": {
      "types": "./types/adapters/nuxt.d.ts",
      "default": "./src/adapters/nuxt.js"
    },
    "./sveltekit": {
      "types": "./types/adapters/sveltekit.d.ts",
      "default": "./src/adapters/sveltekit.js"
    },
    "./vite": {
      "types": "./types/adapters/vite.d.ts",
      "default": "./src/adapters/vite.js"
    },
    "./generate": {
      "types": "./types/generate-catalog.d.ts",
      "default": "./src/generate-catalog.js"
    }
  },
  "bin": {
    "element-js-ssr-renderer": "./bin/element-js-ssr-renderer.js"
  },
  "files": [
    "src",
    "bin",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types",
    "prepublishOnly": "npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "node-html-parser": "^7.0.1"
  },
  "peerDependencies": {
    "@webtides/element-js": ">=1.2.11"
  },
  "devDependencies": {
    "@webtides/element-js": "^1.2.11",
    "@webtides/element-library": "^0.1.2",
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.0"
  }
}
